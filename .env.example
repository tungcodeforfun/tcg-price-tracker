DATABASE_URL=postgres://tcg:tcg@localhost:5432/tcg
# Integration tests run against this database (created by docker/postgres-init.sql)
TEST_DATABASE_URL=postgres://tcg:tcg@localhost:5432/tcg_test

# JustTCG (https://justtcg.com). Free tier is non-commercial: 1,000 req/mo, 100/day, 10/min, 20 cards/request.
JUSTTCG_API_KEY=
JUSTTCG_PLAN=free
# Free tier: comma-separated set ids to sync; empty = newest SYNC_NEWEST_SETS_PER_GAME released sets per game
SYNC_SET_ALLOWLIST=
SYNC_NEWEST_SETS_PER_GAME=3
# Hours before a set is re-synced (default 72 on free, 20 on paid plans)
SYNC_MIN_REFRESH_HOURS=

APP_URL=http://localhost:5173
# openssl rand -base64 32
BETTER_AUTH_SECRET=
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="TCG Price Tracker <no-reply@localhost>"

# Private beta: sign-up requires an invite code unless BETA_INVITES=off
BETA_INVITES=required
BETA_USER_CAP=100
# Beta feedback is emailed here (optional; always stored in the database)
FEEDBACK_EMAIL=

# Card images kill switch: comma-separated game ids whose images are hidden, e.g. pokemon,disney-lorcana
IMAGES_DISABLED_GAMES=
# Takedown contact for rights holders, shown in the footer (optional)
TAKEDOWN_EMAIL=
