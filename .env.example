DATABASE_URL=postgres://tcg:tcg@localhost:5432/tcg
# Integration tests run against this database (created by docker/postgres-init.sql)
TEST_DATABASE_URL=postgres://tcg:tcg@localhost:5432/tcg_test

# JustTCG (https://justtcg.com). Free tier is non-commercial: 1,000 req/mo, 100/day, 10/min, 20 cards/request.
JUSTTCG_API_KEY=
JUSTTCG_PLAN=free
# Comma-separated JustTCG set ids to sync while on the free tier
SYNC_SET_ALLOWLIST=
